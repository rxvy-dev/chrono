#!/bin/sh
# chrono-screenshot [screen|area|window]  — saves to ~/Pictures/Screenshots and copies to the clipboard.
mode="${1:-screen}"
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
file="$dir/Screenshot_$(date +%Y-%m-%d_%H-%M-%S).png"
command -v grim >/dev/null || { notify-send "Screenshot" "Install grim (and slurp) to take screenshots"; exit 1; }
case "$mode" in
    area)   geo="$(slurp)" || exit 0; grim -g "$geo" "$file" ;;
    window) geo="$(chronoctl windows | python3 -c 'import json,sys
w=[x for x in json.load(sys.stdin) if x.get("focused")]
print("%d,%d %dx%d"%(w[0]["x"],w[0]["y"],w[0]["w"],w[0]["h"]) if w else "")' 2>/dev/null)"
            if [ -n "$geo" ]; then grim -g "$geo" "$file"; else grim "$file"; fi ;;
    *)      grim "$file" ;;
esac || exit 1
command -v wl-copy >/dev/null && wl-copy --type image/png <"$file"
command -v notify-send >/dev/null && notify-send -i "$file" "Screenshot saved" "$(basename "$file")"
