# Chrono theme — neon on deep purple, a striped sun and a grid horizon.
[theme]
name = Synthwave
era = modern
description = Neon edges on deep purple, a striped sun and a grid horizon.

[colors]
bg = #1a1033
fg = #f8e9ff
accent = #ff3cac
accent_fg = #ffffff
selection = #ff3cac55
window_bg = #150c2b
window_fg = #f8e9ff
title_active = #2b1650
title_active2 = #1d0f3a
title_active_fg = #ff8ad8
title_inactive = #1d0f3a
title_inactive2 = #170c30
title_inactive_fg = #8a6fb0
border_active = #ff3cac
border_inactive = #3a2466
button_bg = #3a2466
button_fg = #f8e9ff
close_bg = #ff3cac
panel_bg = #12082ae6
panel_fg = #f8e9ff
panel_border = #ff3cac88

[decor]
style = neon
title_height = 32
border_width = 1
corner_radius = 6
title_center = true
buttons = :minimize,maximize,close
button_shape = flat
button_size = 14
shadow = true
shadow_size = 24
shadow_alpha = 0.6

[fonts]
ui = Inter, Noto Sans, DejaVu Sans 10
title = JetBrains Mono, DejaVu Sans Mono Bold 10
mono = JetBrains Mono, DejaVu Sans Mono 10

[panel]
position = bottom
height = 40
style = flat
dock = false

[desktop]
wallpaper = pattern:grid
color1 = #0d0221
color2 = #7b2a8a
