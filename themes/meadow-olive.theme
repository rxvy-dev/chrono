# Chrono theme — Meadow in olive green: glossy khaki title bars and taskbar.
[theme]
name = Meadow Olive
era = retro
description = Meadow in olive green: glossy khaki title bars and taskbar.

[colors]
bg = #ece9d8
fg = #000000
accent = #3a8a2c
accent_fg = #ffffff
selection = #8ba15b
window_bg = #ffffff
window_fg = #000000
title_active = #5f7535
title_active2 = #8ba15b
title_active_fg = #ffffff
title_inactive = #d5dcbd
title_inactive2 = #e2e7cf
title_inactive_fg = #535b39
border_active = #6f8540
border_inactive = #c8d1a8
bevel_light = #ffffff
bevel_dark = #b5b28f
bevel_shadow = #716f64
button_bg = #5b7132
button_fg = #ffffff
close_bg = #e2552c
panel_bg = #5e6f38
panel_fg = #ffffff
panel_border = #b6c58e

[decor]
style = meadow
title_height = 28
border_width = 3
corner_radius = 8
title_center = false
title_bold = true
buttons = :minimize,maximize,close
button_shape = roundrect
button_size = 21
shadow = true
shadow_size = 8
shadow_alpha = 0.3

[fonts]
ui = Tahoma, Noto Sans, DejaVu Sans 9
title = Trebuchet MS, Noto Sans, DejaVu Sans Bold 10
mono = DejaVu Sans Mono 10

[panel]
position = bottom
height = 32
style = gloss
launcher_label = start
dock = false

[desktop]
wallpaper = pattern:hills
color1 = #3d7bd9
color2 = #4d9a2a
